# OpenAI API or OpenAI-compatible API keys and base URLs for LiteLLM models
OPENAI_API_KEY=

# Optional: base URL for OpenAI-compatible APIs.
# Omit this variable to use the default https://api.openai.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic API key for Claude models (if used)
ANTHROPIC_API_KEY=

# GEMINI API key for Gemini models (if used)
GEMINI_API_KEY=
